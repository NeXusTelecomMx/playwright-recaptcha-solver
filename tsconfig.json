{
  "compilerOptions": {
    "module": "NodeNext",
    "declaration": true,
    "declarationMap": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "target": "ES2023",
    "moduleResolution": "NodeNext",
    "outDir": "./dist",
    "baseUrl": "./",
    "sourceMap": false,
    "inlineSourceMap": true,
    "incremental": true,
    "lib": [
      "ES2023",
      "DOM"
    ]
  }
}